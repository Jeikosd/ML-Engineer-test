# Copy to `.env` and adjust. Every key is optional; defaults live in app/config.py.
# Tesseract itself must be installed and on PATH (`tesseract --version`).

# OCR
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=3
OCR_TIMEOUT_S=30
BBOX_ORIGIN=top-left

# Upload limits
MAX_UPLOAD_MB=20
MAX_PAGES=50

# NER (spaCy model; drop all-caps names such as JOHN SMITH)
NER_MODEL=en_core_web_sm
NER_DROP_ALL_CAPS=true

# Embeddings ("cuda" needs a CUDA build of torch)
EMBEDDING_DEVICE=cpu

# Fuzzy matching (0..1)
FUZZY_THRESHOLD=0.90
