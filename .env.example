# Copy to `.env` and adjust. Every key is optional; defaults live in app/config.py.

# OCR — on Windows the Tesseract installer does not add it to PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=3
OCR_TIMEOUT_S=30

# Embeddings ("cuda" needs a CUDA build of torch)
EMBEDDING_DEVICE=cpu
